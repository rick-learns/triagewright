{
  "$defs": {
    "ContentBlock": {
      "discriminator": {
        "mapping": {
          "text": "#/$defs/TextBlock",
          "tool_result": "#/$defs/ToolResultBlock",
          "tool_use": "#/$defs/ToolUseBlock"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TextBlock"
        },
        {
          "$ref": "#/$defs/ToolUseBlock"
        },
        {
          "$ref": "#/$defs/ToolResultBlock"
        }
      ]
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Provider": {
      "enum": [
        "gemini",
        "openrouter",
        "replay"
      ],
      "title": "Provider",
      "type": "string"
    },
    "StopReason": {
      "enum": [
        "end_turn",
        "tool_use",
        "max_tokens",
        "stop_sequence",
        "pause_turn",
        "refusal"
      ],
      "title": "StopReason",
      "type": "string"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    },
    "ToolResultBlock": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "tool_use_id": {
          "title": "Tool Use Id",
          "type": "string"
        },
        "type": {
          "const": "tool_result",
          "default": "tool_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool_use_id",
        "content"
      ],
      "title": "ToolResultBlock",
      "type": "object"
    },
    "ToolUseBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/JsonObject"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "tool_use",
          "default": "tool_use",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ],
      "title": "ToolUseBlock",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Anthropic semantics: ``input_tokens`` excludes cache reads and writes.\n\nAdapters for providers that fold cache tokens into prompt tokens subtract them.",
      "properties": {
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "triagewright/model_response/1.0.0",
  "additionalProperties": false,
  "properties": {
    "content": {
      "items": {
        "$ref": "#/$defs/ContentBlock"
      },
      "title": "Content",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "provider_cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Cost Usd"
    },
    "stop_reason": {
      "$ref": "#/$defs/StopReason"
    },
    "ttft_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttft Ms"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "id",
    "provider",
    "model",
    "content",
    "stop_reason",
    "usage",
    "latency_ms"
  ],
  "title": "ModelResponse",
  "type": "object"
}
