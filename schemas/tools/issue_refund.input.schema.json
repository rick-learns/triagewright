{
  "$id": "triagewright/tools/issue_refund/1.0.0",
  "additionalProperties": false,
  "properties": {
    "amount_cents": {
      "exclusiveMinimum": 0,
      "title": "Amount Cents",
      "type": "integer"
    },
    "approval_id": {
      "anyOf": [
        {
          "pattern": "^apr_[a-z0-9]{4,32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "order_id": {
      "pattern": "^ord_[a-z0-9]{4,32}$",
      "title": "Order Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "amount_cents",
    "reason",
    "idempotency_key"
  ],
  "title": "IssueRefundInput",
  "type": "object"
}
