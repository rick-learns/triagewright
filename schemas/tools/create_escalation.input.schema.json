{
  "$defs": {
    "EscalationQueue": {
      "enum": [
        "tier1",
        "tier2",
        "billing",
        "security"
      ],
      "title": "EscalationQueue",
      "type": "string"
    },
    "EscalationReason": {
      "enum": [
        "policy_limit",
        "approval_required",
        "low_confidence",
        "injection_suspected",
        "customer_requested_human",
        "tool_failure",
        "account_security",
        "account_inactive",
        "legal_or_safety",
        "ungrounded",
        "out_of_scope",
        "loop_limit"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "$id": "triagewright/tools/create_escalation/1.0.0",
  "additionalProperties": false,
  "description": "Idempotent per ticket: a second call for the same ticket returns the first escalation.",
  "properties": {
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "queue": {
      "$ref": "#/$defs/EscalationQueue"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/EscalationReason"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "ticket_id": {
      "pattern": "^tkt_[a-z0-9]{4,32}$",
      "title": "Ticket Id",
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "queue",
    "priority",
    "summary",
    "reason_codes"
  ],
  "title": "CreateEscalationInput",
  "type": "object"
}
