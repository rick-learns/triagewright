{
  "$defs": {
    "ContentBlock": {
      "discriminator": {
        "mapping": {
          "text": "#/$defs/TextBlock",
          "tool_result": "#/$defs/ToolResultBlock",
          "tool_use": "#/$defs/ToolUseBlock"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TextBlock"
        },
        {
          "$ref": "#/$defs/ToolUseBlock"
        },
        {
          "$ref": "#/$defs/ToolResultBlock"
        }
      ]
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "title": "Content",
          "type": "array"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    },
    "ToolChoice": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "default": "auto",
          "enum": [
            "auto",
            "any",
            "tool",
            "none"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ToolChoice",
      "type": "object"
    },
    "ToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "$ref": "#/$defs/JsonObject"
        },
        "name": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "title": "ToolDefinition",
      "type": "object"
    },
    "ToolResultBlock": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "tool_use_id": {
          "title": "Tool Use Id",
          "type": "string"
        },
        "type": {
          "const": "tool_result",
          "default": "tool_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool_use_id",
        "content"
      ],
      "title": "ToolResultBlock",
      "type": "object"
    },
    "ToolUseBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/JsonObject"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "tool_use",
          "default": "tool_use",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ],
      "title": "ToolUseBlock",
      "type": "object"
    }
  },
  "$id": "triagewright/model_request/1.0.0",
  "additionalProperties": false,
  "properties": {
    "max_tokens": {
      "default": 1024,
      "maximum": 64000,
      "minimum": 1,
      "title": "Max Tokens",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "purpose": {
      "default": "unspecified",
      "title": "Purpose",
      "type": "string"
    },
    "system": {
      "title": "System",
      "type": "string"
    },
    "temperature": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.0,
      "title": "Temperature"
    },
    "tool_choice": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolChoice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "model",
    "system",
    "messages"
  ],
  "title": "ModelRequest",
  "type": "object"
}
