# Copy to .env and fill in. Never commit .env.
# Provider: replay (default, no network) | anthropic | openrouter
TW_LLM_PROVIDER=replay

# Only the key for the provider you pick is needed.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Model ids per purpose (provider-specific). Defaults are Anthropic ids.
# TW_MODEL_COORDINATOR=claude-haiku-5-5
# TW_MODEL_TRIAGE=claude-haiku-5-5
# TW_MODEL_ANSWER=claude-haiku-5-5
# TW_MODEL_ACTION=claude-haiku-5-5
# TW_MODEL_ESCALATION=claude-haiku-5-5
# TW_MODEL_JUDGE=claude-sonnet-5-5

# Append live calls to evals/fixtures/recordings/ for later replay.
TW_RECORD=false

# Agent loop bounds
TW_MAX_TURNS=8
TW_TURN_TIMEOUT_S=20
TW_TOTAL_TIMEOUT_S=30

# Policy
TW_REFUND_HARD_LIMIT_CENTS=50000
TW_REFUND_WINDOW_DAYS=30

# Embeddings: hashing (deterministic, no download) | fastembed (local ONNX model)
TW_EMBEDDER=hashing

# MCP transport: inprocess | stdio | http
TW_MCP_TRANSPORT=inprocess
TW_MCP_URL=http://localhost:8765/mcp

# Tracing: none | console | jsonl | otlp
TW_TRACE_EXPORTER=jsonl
TW_OTLP_ENDPOINT=http://localhost:4318

TW_API_HOST=127.0.0.1
TW_API_PORT=8080
