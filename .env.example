# Copy to .env and fill in. Never commit .env.
# Provider: replay (default, no network) | gemini | openrouter. Free models only.
TW_LLM_PROVIDER=replay

# For TW_LLM_PROVIDER=gemini. Use a key whose Google project is on the free
# plan (no billing linked), so usage can never be charged.
GEMINI_API_KEY=
# For TW_LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Model id overrides per purpose. Unset = the provider's free defaults
# (gemini: gemini-3.5-flash-lite, judge gemini-3.8-flash;
#  openrouter: google/gemma-4-31b-it:free, judge nvidia/nemotron-3-ultra-550b-a55b:free).
# Gemini ids must be numbered Flash, Flash-Lite, or Gemma; OpenRouter ids must end in ":free".
# Recordings are keyed by model id.
# TW_MODEL_COORDINATOR=
# TW_MODEL_TRIAGE=
# TW_MODEL_ANSWER=
# TW_MODEL_ACTION=
# TW_MODEL_ESCALATION=
# TW_MODEL_JUDGE=
# Requests per minute per model, paced client-side. Unset: the provider's free-tier
# quota (gemini 15, openrouter 20). 0 turns pacing off.
# TW_LLM_REQUESTS_PER_MINUTE=

# Append live calls to evals/fixtures/recordings/ for later replay.
TW_RECORD=false

# Agent loop bounds
TW_MAX_TURNS=8
TW_TURN_TIMEOUT_S=20
TW_TOTAL_TIMEOUT_S=30
TW_TOOL_RETRIES=2

# Policy
TW_REFUND_HARD_LIMIT_CENTS=50000
TW_REFUND_WINDOW_DAYS=30

# Approvals. Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# Required when the MCP server runs as its own process (stdio/http, compose). Blank = unset.
TW_APPROVAL_KEY=
# Required by the API/CLI to accept approve/reject decisions. Blank = decisions disabled.
TW_APPROVER_TOKEN=

# SQLite files: the mock world and KB index (MCP side) and approvals (API/CLI side).
TW_DB_PATH=var/triagewright.sqlite
TW_APPROVALS_DB_PATH=var/approvals.sqlite

# Embeddings: hashing (deterministic, no download) | fastembed (local ONNX model)
TW_EMBEDDER=hashing

# MCP transport: inprocess | stdio | http
TW_MCP_TRANSPORT=inprocess
TW_MCP_URL=http://localhost:8765/mcp

# Tracing: none | jsonl | otlp
TW_TRACE_EXPORTER=jsonl
TW_OTLP_ENDPOINT=http://localhost:4318

TW_API_HOST=127.0.0.1
TW_API_PORT=8080
